  "keyFeatures": [
    "WhatsApp Business API messaging (send templates, free-form, media)",
    "Inbox — shared team inbox for customer service and sales via WhatsApp",
    "Chatbot — AI-powered and rule-based bots for automated conversations",
    "Campaigns — bulk WhatsApp marketing campaign sending with analytics",
    "Journey — visual automation builder for multi-step customer workflows",
    "Calling — outbound and inbound WhatsApp voice calls",
    "Contacts — CRM-style contact management with custom attributes and segments",
    "CTWA (Click to WhatsApp Ads) — capture leads from Facebook/TikTok ads",
    "WhatsApp Pay & Shop — native payment and storefront support",
    "Integrations — Webhooks, n8n, Freshdesk, HubSpot, e-commerce connectors"
  ],
  "publicApiSurface": [
    "POST /whatsapp/messages — send WhatsApp message directly or enqueued",
    "POST /whatsapp/templates — create message template",
    "GET /whatsapp/templates — list templates",
    "POST /whatsapp/flows — create WhatsApp Flow",
    "POST /whatsapp/calls/connect — initiate WhatsApp call",
    "POST /sms/messages — send SMS",
    "POST /voice/messages — send voice code",
    "POST /email/messages — send email",
    "POST /verification — start phone verification",
    "POST /verification/check — verify OTP code",
    "GET /contacts — list contacts",
    "POST /contacts — create contact",
    "PATCH /contacts/{id} — update contact",
    "POST /webhook-endpoints — create webhook endpoint",
    "GET /balance — retrieve account balance",
    "GET /whatsapp/phone-numbers — list registered phone numbers",
    "POST /custom-events — send custom event",
    "POST /unsubscribers — add unsubscriber"
  ]
